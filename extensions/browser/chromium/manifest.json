{
  "manifest_version": 3,
  "name": "SAYL Download Manager",
  "version": "0.1.0",
  "description": "تكامل سيل مع المتصفح لإدارة وتنزيل الروابط بسرعة وأمان / SAYL browser integration for fast, reliable downloads",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SAYL Download Manager / سيل مدير التنزيلات",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    }
  },
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  }
}
