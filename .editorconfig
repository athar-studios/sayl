# EditorConfig for SAYL
# https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{rs,toml}]
indent_size = 4
end_of_line = lf

[*.{js,json,css,html,yml,yaml,md}]
indent_size = 2
end_of_line = lf

[Makefile]
indent_style = tab
end_of_line = lf

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = crlf